{
  "name": "bedre-riga",
  "version": "0.1.0",
  "description": "BEDRE — Rīga: a 3D browser hole arcade",
  "scripts": {
    "dev": "vite",
    "build": "node tools/mp/check-objects.mjs --fix && vite build",
    "build:web": "vite build",
    "check:mp": "node tools/mp/check-objects.mjs",
    "preview": "vite preview",
    "smoke": "node scripts/smoke.mjs",
    "smoke:world": "node scripts/smoke-world.mjs",
    "smoke:matrix": "node scripts/smoke-matrix.mjs",
    "perf": "node scripts/perf-matrix.mjs",
    "check:radio": "node scripts/check-radio.mjs",
    "check:spawn": "node scripts/spawn-check.mjs",
    "dev:worker": "npm run build:web && wrangler d1 migrations apply bedre-scores --local && wrangler dev --port 8791",
    "smoke:api": "node scripts/smoke-api.mjs",
    "smoke:e2e": "node scripts/smoke-e2e.mjs",
    "gen:limits": "node tools/gen-limits.mjs",
    "check:legit": "node tools/check-legit.mjs",
    "build:mp": "node tools/mp/build-objects.mjs",
    "smoke:mp": "node scripts/smoke-mp.mjs",
    "test:mp": "node scripts/test-mp-sim.mjs",
    "deploy": "npm run build:mp && node tools/mp/check-objects.mjs && npm run build:web && wrangler d1 migrations apply bedre-scores --remote && wrangler deploy"
  },
  "type": "module",
  "dependencies": {
    "hls.js": "^1.5.17",
    "three": "^0.187.0",
    "vite": "^8.3.8"
  },
  "devDependencies": {
    "playwright": "^1.65.1",
    "wrangler": "^4.162.0"
  },
  "private": true
}
