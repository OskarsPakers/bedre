# Cloudflare Workers static assets (served from dist/). Syntax: https://developers.cloudflare.com/workers/static-assets/headers/
# Note: /api/* is generated by the Worker (run_worker_first) and sets its own headers.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

# Vite output is content-hashed: cache forever
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Map data is not hashed: let browsers/CDN reuse it for an hour, then revalidate (ETag)
/data/riga.json
  Cache-Control: public, max-age=3600, must-revalidate
/data/riga-shapes.bin.gz
  Cache-Control: public, max-age=3600, must-revalidate
/data/riga-ground.png
  Cache-Control: public, max-age=3600, must-revalidate
# district maps (public/data/<slug>/...): fetched lazily, only for the selected map
/data/*/riga.json
  Cache-Control: public, max-age=3600, must-revalidate
/data/*/riga-ground.png
  Cache-Control: public, max-age=3600, must-revalidate
/data/*/riga-shapes.bin.gz
  Cache-Control: public, max-age=3600, must-revalidate
/data/*/thumb.png
  Cache-Control: public, max-age=86400

# Placement files (the canonical swallowable-object list of each map, also the multiplayer object table): the client asks for them as
# riga-objects.bin.gz?v=<content id> (id baked into its bundle), so a cached copy can never be the wrong revision; revalidate (ETag) anyway.
/data/riga-objects.bin.gz
  Cache-Control: no-cache
/data/*/riga-objects.bin.gz
  Cache-Control: no-cache
# manifest of the current content ids: only read by a client that was refused online play (is its tab stale?). Never cached.
/data/placements.json
  Cache-Control: no-store

# Entry points: always revalidate so new deploys show up immediately
/
  Cache-Control: public, max-age=0, must-revalidate
/index.html
  Cache-Control: public, max-age=0, must-revalidate
/favicon.svg
  Cache-Control: public, max-age=86400

# [meta/PWA] the service worker must always be revalidated; manifest + icons may be cached briefly
/sw.js
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: public, max-age=86400
/icons/*
  Cache-Control: public, max-age=604800
/data/riga-areas.json
  Cache-Control: public, max-age=3600, must-revalidate
/og.png
  Cache-Control: public, max-age=86400
