{
  // One Worker: static assets (Vite build in dist/) + /api/* backed by D1.
  // Deploy: npm run deploy   (see README "Backend / deploy")
  "name": "bedre",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    // Only /api/* runs the Worker first; everything else is served straight from assets.
    "run_worker_first": ["/api/*"]
  },
  "routes": [
    { "pattern": "bedre.pakers.lv", "custom_domain": true }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bedre-scores",
      "database_id": "53e512d3-af11-4c1c-ae1f-9ed1e00221cd",
      "migrations_dir": "migrations"
    }
  ],
  // Multiplayer (worker/mp/): one Durable Object per room + one tiny matchmaker. SQLite-backed classes (the only kind
  // available on the free plan) are declared with `new_sqlite_classes`. Tag must be unique and never reused.
  "durable_objects": {
    "bindings": [
      { "name": "MP_ROOM", "class_name": "MpRoom" },
      { "name": "MP_MATCHMAKER", "class_name": "MpMatchmaker" }
    ]
  },
  "migrations": [
    { "tag": "mp-v1", "new_sqlite_classes": ["MpRoom", "MpMatchmaker"] }
  ],
  "observability": { "logs": { "enabled": true } }
}
